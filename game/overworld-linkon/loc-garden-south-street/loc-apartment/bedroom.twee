:: Apartment Bedroom
<<initPlayState>>\
<<if !Player.isOlder()>><<goto "Garden South Street">><</if>>\
<<run World.setLocation("apartment-bedroom", "Garden South Street — Apartment")>>\
You stand in the bedroom of your apartment.

<<actionIcon "sleep-apt">><<link "Sleep in what you’re currently wearing">><<goto "Apartment Bedroom Sleep">><</link>>
<<gap>>
<<icon "living-room">><<link "Go to Living Room <span class='action-time'>(0:01)</span>">><<run World.advance(1)>><<goto "Apartment Living Room">><</link>>
<<icon "kitchen">><<link "Go to Kitchen <span class='action-time'>(0:02)</span>">><<run World.advance(2)>><<goto "Apartment Kitchen">><</link>>
<<gap>>
<<icon "apartment-hall">><<link "Leave Apartment <span class='action-time'>(0:02)</span>">><<run World.advance(2)>><<goto "Apartment Hallway">><</link>>
<<icon "apartment-ml-door">><<link "Leave Apartment Complex <span class='action-time'>(0:04)</span>">><<run World.advance(4)>><<goto "Garden South Street">><</link>>


:: Apartment Bedroom Sleep
<<initPlayState>>\
<<if !Player.isOlder()>><<goto "Garden South Street">><</if>>\
<<run World.setLocation("apartment-bedroom", "Garden South Street — Apartment")>>\
You climb in bed, cuddling into the plush sheets.

<<sleepChoices "Apartment Bedroom Wake" "Apartment Bedroom">>

:: Apartment Bedroom Wake
<<initPlayState>>\
<<if !Player.isOlder()>><<goto "Garden South Street">><</if>>\
<<run World.setLocation("apartment-bedroom", "Garden South Street — Apartment")>>\
<<sleepWake "Apartment Bedroom">>
