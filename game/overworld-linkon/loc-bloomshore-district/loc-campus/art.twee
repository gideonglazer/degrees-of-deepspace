:: Campus Art
<<initPlayState>>\
<<if !School.isSchoolDay()>><<goto "Linkon University">><</if>>\
<<pronouns "rafayel">>\
<<run World.setLocation("campus-art", "Bloomshore District — Linkon University")>>\
