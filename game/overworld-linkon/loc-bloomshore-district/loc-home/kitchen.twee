:: Bloomshore Kitchen
<<initPlayState>>\
<<if !Player.isYounger()>><<goto "Bloomshore District">><</if>>\
<<pronouns "caleb">>\
<<run World.setLocation("bloomshore-kitchen", "Bloomshore District — Home")>>\
<<run CalebBreakfast.ensure()>>\
<<kitchenFlavor "bloomshore-kitchen">>
<<gap>>
<<kitchenCookActions>>\
<<gap>>
<<icon "apartment-hall">><<link "Leave the kitchen <span class='action-time'>(0:01)</span>">><<run World.advance(1)>><<goto "Bloomshore Downstairs">><</link>>

:: Bloomshore Kitchen Breakfast
<<initPlayState>>\
<<if !Player.isYounger()>><<goto "Bloomshore District">><</if>>\
<<pronouns "caleb">>\
<<run CalebBreakfast.ensure()>>\
<<set _meal to CalebBreakfast.meal($calebBreakfast.id)>>\
<<if CalebBreakfast.available() && _meal>>\
<<set _fx to CalebBreakfast.eat()>>\
<<calebBreakfastText>> <<= _fx>>
<<gap>>
<<link `"Finish eating your " + _meal.name`>><<goto "Bloomshore Kitchen">><</link>>
<<else>>\
<<goto "Bloomshore Kitchen">>
<</if>>
