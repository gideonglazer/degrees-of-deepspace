:: StoryMenu
<<link "Social">><<run Social.openDialog()>><</link>>
<<if School.applies()>><<link "Skills">><<run School.openDialog()>><</link>><</if>>
<<link "Journal">><<run Journal.openDialog()>><</link>>

:: StoryCaption
<<if passage() !== "Start">>\
<<run World.ensure()>><<run Stats.ensure()>><<run LoveInterests.ensure()>><<run Flags.ensure()>><<run Journal.ensure()>><<run School.ensure()>><<run Options.ensure()>><<run Money.get()>>\
<<set _clockHands to World.clockHandAngles()>>\
<<set _fullDate to World.formatDateLong()>>\
<<set _hourHandStyle to "transform: rotate(" + _clockHands.hour + "deg)">>\
<<set _minuteHandStyle to "transform: rotate(" + _clockHands.minute + "deg)">>\
<div id="hud" class="hud">\
<div class="hud-status" role="group" aria-label="Status">\
<span class="hud-status-item hud-money"><<= Money.format(Money.get())>></span>\
<span class="hud-status-item hud-time">\
<span class="hud-clock" aria-hidden="true">\
<span class="hud-clock-face">\
<span class="hud-clock-hand hud-clock-hand-hour" @style="_hourHandStyle"></span>\
<span class="hud-clock-hand hud-clock-hand-minute" @style="_minuteHandStyle"></span>\
<span class="hud-clock-center"></span>\
</span>\
</span>\
<span class="hud-time-text"><<= World.formatTime()>></span>\
</span>\
<span class="hud-status-item hud-weekday" tabindex="0" @aria-label="_fullDate">\
<span class="hud-calendar-icon" aria-hidden="true">\
<svg viewBox="0 0 16 16" width="14" height="14" focusable="false">\
<rect x="1.5" y="2.5" width="13" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.25"/>\
<path d="M1.5 6.25h13" fill="none" stroke="currentColor" stroke-width="1.25"/>\
<path d="M5 1.25v2.5M11 1.25v2.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>\
<rect x="4" y="8.25" width="2" height="2" fill="currentColor"/>\
<rect x="7" y="8.25" width="2" height="2" fill="currentColor"/>\
<rect x="10" y="8.25" width="2" height="2" fill="currentColor"/>\
</svg>\
</span>\
<span class="hud-weekday-text"><<= World.weekdayShort()>></span>\
<span class="hud-weekday-tooltip"><<= _fullDate>></span>\
</span>\
</div>\
<div class="hud-row hud-weather"><<= World.weatherText()>>, <<= World.formatTemperature()>></div>\
<<if $world.locationLabel>><div class="hud-row hud-location"><<= $world.locationLabel>></div><</if>>\
\
<div class="hud-condition">\
<<hudStat "pain">>\
<<hudStat "arousal">>\
<<hudStat "energy">>\
<<hudStat "stress">>\
<<hudStat "control">>\
<<hudStat "hygiene">>\
<<hudStat "hunger">>\
</div>\
\
<<hudTip>>\
</div>\
<</if>>

:: Social Widgets [widget]
<<widget "socialContents">>\
<<run LoveInterests.ensure()>><<run Flags.ensure()>>\
<div class="social">\
<h3 class="social-section">Primary Relationships</h3>\
<<set _known to LoveInterests.known()>>\
<<if !_known.length>>\
<p class="social-empty">You have no relationships yet.</p>\
<<else>>\
<div class="social-grid">\
<<for _li range _known>>\
<<socialCard `_li.id`>>\
<</for>>\
</div>\
<</if>>\
</div>\
<</widget>>

:: Skills Widgets [widget]
<<widget "skillsContents">>\
<<if School.applies()>><<run School.ensure()>><<= School.skillsMarkup()>><</if>>\
<</widget>>

:: Journal Widgets [widget]
<<widget "journalContents">>\
<<run Journal.ensure()>>\
<div class="journal">\
<<set _notes to Journal.listSorted()>>\
<<if !_notes.length>>\
<p class="journal-empty">Your journal is empty.</p>\
<<else>>\
<<set _shownPermanent to false>>\
<<set _shownOther to false>>\
<<for _note range _notes>>\
<<if _note.permanent && !_shownPermanent>>\
<h3 class="journal-section">Reminders</h3>\
<<set _shownPermanent to true>>\
<</if>>\
<<if !_note.permanent && !_shownOther>>\
<h3 class="journal-section">Notes</h3>\
<<set _shownOther to true>>\
<</if>>\
<div class="journal-entry<<if _note.permanent>> journal-permanent<</if>>"><<= _note.text>></div>\
<</for>>\
<</if>>\
</div>\
<</widget>>
